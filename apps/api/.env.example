# Postgres connection string (Neon, Supabase, RDS or local)
DATABASE_URL=postgres://ugent:ugent@localhost:5432/ugent
# Long random string used to sign app sessions: openssl rand -base64 48
AUTH_SECRET=change-me
# Claude API key for cloud chat. Without it, chat answers with the on-device agent.
ANTHROPIC_API_KEY=
# Shared secret set in RevenueCat > Integrations > Webhooks > Authorization header
REVENUECAT_WEBHOOK_AUTH=
# Shown on /privacy (App Store and Play Store require a privacy contact)
PRIVACY_CONTACT_EMAIL=
# Browser origins allowed to call the API (comma-separated). Phone apps do not need this.
ALLOWED_ORIGINS=
